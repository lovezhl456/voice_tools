# Optional test-only tools; production latency image remains unchanged.
FROM voice-tools-latency:0.15.1
USER root
RUN apt-get update && apt-get install -y --no-install-recommends nodejs procps && rm -rf /var/lib/apt/lists/*
USER 10001:10001

USER root
RUN apt-get update && apt-get install -y --no-install-recommends tcpdump && rm -rf /var/lib/apt/lists/*
USER 10001:10001
