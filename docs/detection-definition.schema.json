    "scope": {
      "type": "object",
      "properties": {
        "start_s": {
          "type": "number",
          "minimum": 0,
          "maximum": 3600
        },
        "end_s": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 3600
            },
            {
              "type": "null"
            }
          ]
        },
        "skip_first_s": {
          "type": "number",
          "minimum": 0,
          "maximum": 3600
        },
        "skip_last_s": {
          "type": "number",
          "minimum": 0,
          "maximum": 3600
        },
        "exclude": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "properties": {
              "start_s": {
                "type": "number",
                "minimum": 0,
                "maximum": 3600
              },
              "end_s": {
