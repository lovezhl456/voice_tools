{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "voice-tools detection definition 1.0",
  "$defs": {
    "condition": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "all": {
              "type": "array",
              "minItems": 1,
              "maxItems": 128,
              "items": {
                "$ref": "#/$defs/condition"
              }
            }
          },
          "required": [
            "all"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "any": {
              "type": "array",
              "minItems": 1,
              "maxItems": 128,
              "items": {
                "$ref": "#/$defs/condition"
              }
            }
          },
          "required": [
            "any"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "not": {
              "$ref": "#/$defs/condition"
            }
          },
          "required": [
            "not"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "metric": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
              "maxLength": 80
            },
            "op": {
              "enum": [
                "lt",
                "le",
                "gt",
                "ge",
                "eq",
                "ne"
              ]
            },
            "value": {
              "type": "number",
              "minimum": -1000000000000.0,
              "maximum": 1000000000000.0
            }
          },
          "required": [
            "metric",
            "op",
            "value"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
