                  "maximum": 0,
                  "default": -45
                },
                "min_duration_s": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 3600,
                  "default": 0.1
                },
                "join_gap_s": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 120,
                  "default": 0
                },
                "remove_dc": {
                  "type": "boolean",
                  "default": true
